<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- WPF0001: Fluent ThemeMode is marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Version>1.0.0</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">1.0.0-preview.3</InformationalVersion>
    <WindowsBuildNumber Condition="'$(WindowsBuildNumber)' == ''">3</WindowsBuildNumber>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.$(WindowsBuildNumber)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Velinshot</Company>
    <Product>Velinshot</Product>
    <Copyright>Copyright (c) 2026 Jack Nelson. MIT License.</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
